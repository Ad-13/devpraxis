NODE_ENV=development
PORT=3000

# Atlas or a local instance
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/devpraxis

# Generate, do not invent:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long

# Minutes. Lower it to a few to exercise the session-refresh flow.
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Any OpenAI-compatible endpoint.
# Groq:   https://api.groq.com/openai/v1
# Ollama: http://localhost:11434/v1  (then AI_API_KEY can be any non-empty string)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=change-me

# Where the web app runs. Must match the browser's address exactly,
# scheme included, no trailing slash — the CSRF check compares it verbatim.
WEB_ORIGIN=http://localhost:3001

# Number of proxy hops to trust. 0 locally, 1 behind Render or Vercel.
TRUST_PROXY=0

# Serves Swagger UI at /docs. Off by default: the schema is a detailed map
# of every endpoint, including the authenticated ones.
ENABLE_DOCS=true